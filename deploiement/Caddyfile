# Caddyfile de Petit Cortège (Caddy 2, HTTPS automatique Let's Encrypt).
# Installé par `installer.sh` dans /etc/caddy/Caddyfile.
#
# ÉTAT DE VALIDATION : le texte de ce fichier a été validé avec `caddy validate`
# (Caddy 2.6.2, paquet Ubuntu) et exercé en HTTP local, sans TLS. Il n'a PAS encore
# été essayé sur le VPS avec la dernière version de Caddy : lance une fois
#   DOMAINE=<ton-domaine> caddy validate --config /etc/caddy/Caddyfile
# avant la mise en ligne, puis supprime cette note.
#
# Le nom de domaine vient de la variable d'environnement DOMAINE, posée par
# `installer.sh` dans /etc/systemd/system/caddy.service.d/petit-cortege.conf
# (pas besoin de modifier ce fichier).
#
# Rôles :
#   /api/*      -> serveur Node (127.0.0.1:8787) : défi ALTCHA, entrée, retrait
#   /publie/*   -> fichiers publiés, servis DIRECTEMENT par Caddy depuis le disque
#   /decors/*, /assets/*, /  -> client compilé (client/dist)
#
# Pourquoi Caddy sert /publie/ lui-même plutôt que le serveur Node (SERVIR_PUBLICATION=1) :
#  - le serveur Node ne pose que le cache court de manifs.json et retraits.json, pas le
#    cache « immuable » des fichiers entrees/* (voir server/src/serveur.ts) ;
#  - ces fichiers continuent d'être servis même si Node redémarre ou plante ;
#  - ils sont écrits par rename atomique (server/src/publication.ts) : Caddy ne voit jamais
#    un fichier à moitié écrit.
# Dans ce choix, SERVIR_PUBLICATION reste absent du fichier d'environnement.
{
	# Journaux : aucun journal d'accès (Caddy n'en écrit que si un bloc `log` est présent
	# dans le site : il n'y en a pas, ADR 0002/0005). Reste le journal de fonctionnement
	# (certificats, démarrage), qui part dans journald. Trois enregistreurs y écrivent
	# l'adresse IP du visiteur et sont donc exclus :
	#  - http.log.access : journal d'accès ;
	#  - http.log.error  : erreurs de requête (502, etc.), avec la requête entière ;
	#  - http.stdlib     : « TLS handshake error from <ip> ».
	# Les erreurs de certificat (tls.*) et de démarrage restent visibles.
	log {
		output stderr
		level INFO
		exclude http.log.access http.log.error http.stdlib
	}
}

{$DOMAINE} {
	# Compression (gzip pour les anciens clients, zstd sinon) : le test de charge compte sur
	# un JSON compressé (docs/test-de-charge.md : facteur 3 sur la bande passante).
	encode zstd gzip

	# En-têtes de sécurité, pour toutes les réponses.
	#
	# Content-Security-Policy, d'après ce que charge le client (lu dans client/src) :
	#  - script-src 'self'  : un seul bundle, des modules du même domaine, aucun eval ;
	#    plus https://stats.petit-cortege.fr : le script Umami (script.js), chargé seulement
	#    en production si VITE_UMAMI_WEBSITE_ID est défini au build. Pas d'autre hôte ;
	#  - worker-src 'self' blob: : workers de la preuve de travail ALTCHA (preuve-travail.ts,
	#    fichier du build) ; blob: par prudence pour les workers créés par les bibliothèques ;
	#  - style-src 'unsafe-inline' : l'interface est écrite en innerHTML avec des attributs
	#    style (un style en ligne n'exécute pas de script) ;
	#  - img-src data: blob: : textures Phaser/Three.js, image finale (canvas -> PNG, blob:) ;
	#  - connect-src 'self' : /api, /publie, /decors, le même domaine ;
	#    plus https://stats.petit-cortege.fr : les envois de mesure (POST /api/send). Rien d'autre ;
	#  - WebGL (vue 3D) et le Canvas ne dépendent pas de la CSP ;
	#  - aucun fichier audio chargé : un son produit par Web Audio, sans fichier, n'a besoin
	#    d'aucune directive CSP ; un fichier audio serait couvert par default-src 'self' ;
	#  - Umami est auto-hébergé sur ce VPS (page vie privée), pas un service d'une autre
	#    organisation. N'élargir aucune autre directive.
	#
	# Production (petit-cortege.fr) : le reverse proxy est Nginx, pas Caddy (ADR 0005).
	# mettre-a-jour.sh recopie CE fichier vers /etc/caddy/Caddyfile. Il ne touche pas à
	# Nginx. L'en-tête ci-dessous doit être recopié à la main dans le vhost Nginx du VPS.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://stats.petit-cortege.fr; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://stats.petit-cortege.fr; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# HTTPS pour un an. Sans includeSubDomains ni preload : on ne s'engage pas pour d'autres sous-domaines.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# L'adresse de la manif est dans le fragment (#/manif/…) : jamais transmise de toute façon ;
		# ceci évite en plus l'en-tête Referer vers d'autres sites (lien OpenStreetMap).
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# --- API : serveur Node local -------------------------------------------------------
	handle /api/* {
		# Le serveur Node limite déjà le corps à 8 Kio ; on coupe plus tôt.
		request_body {
			max_size 16KB
		}
		# Adresse du visiteur : Caddy la transmet dans X-Forwarded-For (comportement par défaut
		# de reverse_proxy). server/src/ip-client.ts lit cet en-tête UNIQUEMENT si la connexion
		# vient d'un proxy de confiance : PROXYS_DE_CONFIANCE=127.0.0.1,::1 dans
		# /etc/petit-cortege.env. Sans option `trusted_proxies` (c'est le cas ici : Caddy est
		# directement face à Internet), Caddy EFFACE l'en-tête envoyé par le visiteur et le
		# remplace par l'adresse qu'il voit : on ne peut pas forger sa propre IP pour
		# contourner la limite par IP (vérifié, voir docs/deploiement.md). NE PAS ajouter
		# `trusted_proxies` ici sans revoir PROXYS_DE_CONFIANCE (CDN : section « Plus tard »).
		# L'adresse ne sert que de clé en mémoire côté Node (ADR 0001), jamais écrite.
		reverse_proxy 127.0.0.1:8787
	}

	# --- Fichiers publiés (liste des manifs, entrées par minute et par heure, retraits) --
	# Dossier écrit par le serveur Node (DOSSIER_PUBLICATION) et lu ici par Caddy.
	handle_path /publie/* {
		root * /var/lib/petit-cortege/publie

		# Réécrits à chaque publication : cache court (DUREE_CACHE_COURT_S = 30 s dans
		# shared/src/format.ts). Un retrait ou un départ corrigé se propage en moins d'une minute.
		@courts path /manifs.json /retraits.json
		header @courts Cache-Control "public, max-age=30"

		# Fichiers par minute et par heure : immuables une fois écrits. Le client redemande
		# un fichier pas encore publié (404, voir client/src/publication.ts) : l'en-tête
		# « immuable » n'est donc posé que si le fichier EXISTE, sinon un 404 serait
		# gardé un an par les navigateurs et les CDN.
		@entrees {
			path /entrees/*
			file
		}
		header @entrees Cache-Control "public, max-age=31536000, immutable"

		file_server
	}

	# --- Pages de manif et sitemap (générés par Node, ADR 0010) --------------------------
	# Une manif est créée après le build : il n'y a pas de fichier statique à jour.
	# Node lit la base et renvoie le HTML. Le script de l'application reste servi
	# ci-dessous, depuis client/dist. Pas de journal d'accès en plus : le bloc `log`
	# global exclut déjà http.log.access, et l'adresse contient l'identifiant public.
	handle /sitemap.xml {
		reverse_proxy 127.0.0.1:8787
	}
	handle /manif/* {
		reverse_proxy 127.0.0.1:8787
	}

	# --- Client compilé (npm run build -> client/dist) ----------------------------------
	handle {
		root * /opt/petit-cortege/client/dist

		# Fichiers à empreinte (nom différent à chaque build) : cache d'un an. Même précaution
		# que ci-dessus : seulement si le fichier existe.
		@assets {
			path /assets/*
			file
		}
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# La page d'entrée change à chaque build : toujours revalidée (réponse 304 si inchangée).
		@page path / /index.html
		header @page Cache-Control "no-cache"

		# Décors (client/public/decors) : sans empreinte, et modifiés à chaque nouvelle manif.
		# Revalidation à chaque ouverture (ETag de Caddy, réponse 304 si inchangés).
		@decors path /decors/*
		header @decors Cache-Control "no-cache"

		# Autres fichiers (apercu.png…) : une heure.
		@autres not path / /index.html /assets/* /decors/*
		header @autres Cache-Control "public, max-age=3600"

		file_server
	}
}
